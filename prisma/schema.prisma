generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum RoleName {
  SUPER_ADMIN
  DIRECTION
  ADMIN_SCOLAIRE
  COMPTABILITE
  RH
  PARENT
  CANDIDAT
}

model Role {
  id    String     @id @default(cuid())
  name  RoleName   @unique
  users User[]
}

model User {
  id            String    @id @default(cuid())
  email         String    @unique
  passwordHash  String
  isActive      Boolean   @default(true)
  failedLogins  Int       @default(0)
  lockedUntil   DateTime?
  role          Role      @relation(fields: [roleId], references: [id])
  roleId        String
  parent        Parent?
candidature   Candidature?
  refreshTokens RefreshToken[]
  auditLogs     AuditLog[]
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
}

model RefreshToken {
  id        String   @id @default(cuid())
  tokenHash String   @unique
  user      User     @relation(fields: [userId], references: [id])
  userId    String
  expiresAt DateTime
  revoked   Boolean  @default(false)
  createdAt DateTime @default(now())
}

model Parent {
  id        String        @id @default(cuid())
  user      User          @relation(fields: [userId], references: [id])
  userId    String        @unique
  nom       String
  prenom    String
  telephone String
  whatsapp  String?
  adresse   String?
  eleves    ParentEleve[]
  createdAt DateTime      @default(now())
}

model AuditLog {
  id        String   @id @default(cuid())
  user      User?    @relation(fields: [userId], references: [id])
  userId    String?
  action    String
  cibleType String?
  cibleId   String?
  ip        String?
  createdAt DateTime @default(now())
}
enum Cycle {
  PRESCOLAIRE
  PRIMAIRE
  COLLEGE
  LYCEE
}

model Classe {
  id        String   @id @default(cuid())
  nom       String   @unique
  cycle     Cycle
  eleves    Eleve[]
candidatures Candidature[]
  createdAt DateTime @default(now())
}

model Eleve {
  id            String        @id @default(cuid())
  matricule     String        @unique
  nom           String
  prenom        String
  dateNaissance DateTime
  sexe          String
  classe        Classe        @relation(fields: [classeId], references: [id])
  classeId      String
  parents       ParentEleve[]
  isActive      Boolean       @default(true)
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt
}

model ParentEleve {
  id       String @id @default(cuid())
  parent   Parent @relation(fields: [parentId], references: [id])
  parentId String
  eleve    Eleve  @relation(fields: [eleveId], references: [id])
  eleveId  String
  lien     String @default("Parent")

  @@unique([parentId, eleveId])
}
